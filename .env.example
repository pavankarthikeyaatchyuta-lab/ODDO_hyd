# StockSense Root Environment Template

# Backend
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="stocksense-dev-jwt-access-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="stocksense-dev-jwt-refresh-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
LOG_LEVEL="info"

# Frontend
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_APP_NAME="StockSense"
