// StockSense Prisma Relational Schema
// Database Engine: SQLite (Local zero-dependency development) / PostgreSQL (Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. User, Role & Access Control
// ==========================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String    @default("WAREHOUSE_STAFF") // ADMIN, INVENTORY_MANAGER, WAREHOUSE_STAFF, VIEWER_AUDITOR
  isActive       Boolean   @default(true)
  otpSecret      String?
  otpExpiresAt   DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stockMovements   StockLedger[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  countsAssigned   InventoryCountItem[]
  stockAdjustments StockAdjustment[]
}

// ==========================================
// 2. Spatial Warehouse Hierarchy
// ==========================================

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. WH-MAIN
  name        String
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones            Zone[]
  reorderRules     ReorderRule[]
  counts           InventoryCount[]
  receipts         Receipt[]
  deliveryOrders   DeliveryOrder[]
  sourceTransfers  Transfer[]        @relation("SourceWarehouse")
  destTransfers    Transfer[]        @relation("DestWarehouse")
  stockAdjustments StockAdjustment[]
  stockLedgers     StockLedger[]
}

model Zone {
  id          String    @id @default(uuid())
  warehouseId String
  code        String    // e.g. Z-COLD, Z-BULK
  name        String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  racks       Rack[]

  @@unique([warehouseId, code])
}

model Rack {
  id          String   @id @default(uuid())
  zoneId      String
  code        String   // e.g. R01
  aisleNumber String?
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  shelves     Shelf[]

  @@unique([zoneId, code])
}

model Shelf {
  id          String   @id @default(uuid())
  rackId      String
  code        String   // e.g. S01
  levelNumber Int?
  rack        Rack     @relation(fields: [rackId], references: [id], onDelete: Cascade)
  bins        Bin[]

  @@unique([rackId, code])
}

model Bin {
  id             String         @id @default(uuid())
  shelfId        String
  code           String         // e.g. B01 -> Full path: WH-MAIN-Z-COLD-R01-S01-B01
  barcode        String         @unique
  isLocked       Boolean        @default(false)
  shelf          Shelf          @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockLedgers   StockLedger[]
  receiptItems   ReceiptItem[]
  deliveryItems  DeliveryOrderItem[]
  countItems     InventoryCountItem[]
  transfersOrigin  TransferItem[]        @relation("TransferOrigin")
  transfersDest    TransferItem[]        @relation("TransferDest")
  stockAdjustments StockAdjustment[]

  @@unique([shelfId, code])
}

// ==========================================
// 3. Product Catalog & Rules
// ==========================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id               String          @id @default(uuid())
  sku              String          @unique
  name             String
  description      String?
  categoryId       String
  uom              String          @default("PCS") // PCS, KG, METER, LITER, BOX
  costPrice        Float           @default(0.0)
  salePrice        Float           @default(0.0)
  minStock         Float           @default(10.0)
  maxStock         Float           @default(100.0)
  reorderQuantity  Float           @default(20.0)
  isActive         Boolean         @default(true)
  isBatchTracked   Boolean         @default(false)
  isSerialTracked  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  category         Category        @relation(fields: [categoryId], references: [id])
  stockBalances    StockBalance[]
  stockLedgers     StockLedger[]
  reorderRules     ReorderRule[]
  batches          Batch[]
  purchaseItems    PurchaseOrderItem[]
  receiptItems     ReceiptItem[]
  deliveryItems    DeliveryOrderItem[]
  transferItems    TransferItem[]
  countItems       InventoryCountItem[]
  stockAdjustments StockAdjustment[]
  reservations     StockReservation[]
  forecasts        Forecast[]
  aiInsights       AIInsight[]
}

model ReorderRule {
  id               String    @id @default(uuid())
  productId        String
  warehouseId      String
  minStock         Float
  maxStock         Float
  safetyStock      Float     @default(0.0)
  reorderQuantity  Float
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

// ==========================================
// 4. Batch, Serial & Real-time Stock Balance
// ==========================================

model Batch {
  id             String          @id @default(uuid())
  productId      String
  batchNumber    String
  mfgDate        DateTime?
  expiryDate     DateTime?
  isQuarantined  Boolean         @default(false)
  createdAt      DateTime        @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  serialNumbers  SerialNumber[]
  receiptItems   ReceiptItem[]

  @@unique([productId, batchNumber])
}

model SerialNumber {
  id             String    @id @default(uuid())
  batchId        String?
  serialNumber   String    @unique
  status         String    @default("IN_STOCK") // IN_STOCK, RESERVED, DELIVERED, SCRAPPED
  createdAt      DateTime  @default(now())

  batch          Batch?    @relation(fields: [batchId], references: [id])
}

model StockBalance {
  id             String    @id @default(uuid())
  productId      String
  binId          String
  batchId        String?
  physicalQty    Float     @default(0.0)
  reservedQty    Float     @default(0.0)
  updatedAt      DateTime  @updatedAt

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bin            Bin       @relation(fields: [binId], references: [id], onDelete: Cascade)
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([productId, binId])
}

model StockReservation {
  id              String    @id @default(uuid())
  referenceDocType String   // DELIVERY_ORDER
  referenceDocId   String
  productId       String
  quantity        Float
  expiresAt       DateTime
  status          String    @default("ACTIVE") // ACTIVE, COMMITTED, CANCELLED
  createdAt       DateTime  @default(now())

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. Operations: Procurement & Inbound Receipts
// ==========================================

model Supplier {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  contactEmail   String?
  phone          String?
  address        String?
  leadTimeDays   Int             @default(7)
  createdAt      DateTime        @default(now())

  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  poNumber       String              @unique
  supplierId     String
  status         String              @default("DRAFT") // DRAFT, APPROVED, PARTIALLY_RECEIVED, FULLY_RECEIVED, CLOSED
  totalAmount    Float               @default(0.0)
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  receipts       Receipt[]
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Float
  quantityReceived Float         @default(0.0)
  unitCost         Float

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])
}

model Receipt {
  id              String        @id @default(uuid())
  receiptNumber   String        @unique
  purchaseOrderId String?
  supplierId      String?
  warehouseId     String?
  status          String        @default("DRAFT") // DRAFT, READY, VALIDATED, DONE, CANCELLED
  receivedAt      DateTime?
  validatedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id])
  items           ReceiptItem[]
}

model ReceiptItem {
  id             String    @id @default(uuid())
  receiptId      String
  productId      String
  binId          String
  batchId        String?
  quantityReceived Float

  receipt        Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id])
  bin            Bin       @relation(fields: [binId], references: [id])
  batch          Batch?    @relation(fields: [batchId], references: [id])
}

// ==========================================
// 6. Operations: Outbound Delivery Orders
// ==========================================

model DeliveryOrder {
  id             String              @id @default(uuid())
  doNumber       String              @unique
  customerName   String
  warehouseId    String?
  status         String              @default("DRAFT") // DRAFT, READY, PICKING, PACKED, VALIDATED, DONE, CANCELLED
  dispatchedAt   DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  items          DeliveryOrderItem[]
}

model DeliveryOrderItem {
  id              String        @id @default(uuid())
  deliveryOrderId String
  productId       String
  binId           String
  quantityDemanded Float
  quantityPicked  Float         @default(0.0)

  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  bin             Bin           @relation(fields: [binId], references: [id])
}

// ==========================================
// 7. Operations: Internal Transfers
// ==========================================

model Transfer {
  id                String         @id @default(uuid())
  transferNumber    String         @unique
  sourceWarehouseId String?
  destWarehouseId   String?
  status            String         @default("DRAFT") // DRAFT, READY, IN_TRANSIT, DONE, CANCELLED
  initiatedAt       DateTime       @default(now())
  completedAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt

  sourceWarehouse   Warehouse?     @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse?     @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  items             TransferItem[]
}

model TransferItem {
  id              String    @id @default(uuid())
  transferId      String
  productId       String
  sourceBinId     String
  destBinId       String
  quantity        Float

  transfer        Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])
  sourceBin       Bin       @relation("TransferOrigin", fields: [sourceBinId], references: [id])
  destBin         Bin       @relation("TransferDest", fields: [destBinId], references: [id])
}

// ==========================================
// 8. Cycle Count & Physical Inventory
// ==========================================

model InventoryCount {
  id             String               @id @default(uuid())
  sessionNumber  String               @unique
  warehouseId    String
  status         String               @default("PLANNED") // PLANNED, IN_PROGRESS, RECONCILING, APPROVED, CANCELLED
  createdAt      DateTime             @default(now())
  closedAt       DateTime?

  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id])
  items          InventoryCountItem[]
  adjustments    StockAdjustment[]
}

model InventoryCountItem {
  id               String         @id @default(uuid())
  inventoryCountId String
  productId        String
  binId            String
  systemQty        Float
  countedQty       Float?
  variance         Float?
  countedById      String?

  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
  bin              Bin            @relation(fields: [binId], references: [id])
  countedBy        User?          @relation(fields: [countedById], references: [id])
}

model StockAdjustment {
  id               String          @id @default(uuid())
  adjustmentNumber String          @unique
  inventoryCountId String?
  productId        String
  binId            String
  warehouseId      String?
  recordedQty      Float           @default(0.0)
  countedQty       Float           @default(0.0)
  differenceQty    Float           @default(0.0)
  reasonCode       String          // DAMAGED, LOST, FOUND, COUNTING_ERROR, DATA_CORRECTION, OTHER
  notes            String?
  adjustedById     String?
  createdAt        DateTime        @default(now())

  inventoryCount   InventoryCount? @relation(fields: [inventoryCountId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  bin              Bin             @relation(fields: [binId], references: [id])
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  adjustedBy       User?           @relation(fields: [adjustedById], references: [id])
}

// ==========================================
// 9. Immutable Stock Ledger Journal
// ==========================================

model StockLedger {
  id                 String     @id @default(uuid())
  timestamp          DateTime   @default(now())
  productId          String
  sku                String
  warehouseId        String?
  binId              String
  movementType       String     // RECEIPT, DELIVERY, INTERNAL_TRANSFER, ADJUSTMENT, RESERVATION, RELEASE
  quantity           Float
  qtyBefore          Float
  qtyAfter           Float
  referenceDocType   String?    // RECEIPT, DELIVERY_ORDER, INTERNAL_TRANSFER, STOCK_ADJUSTMENT, PO, COUNT
  referenceDocId     String?
  referenceDocNumber String?
  sourceLocation     String?
  destLocation       String?
  performedById      String?
  reason             String?
  recordHash         String?
  createdAt          DateTime   @default(now())

  product            Product    @relation(fields: [productId], references: [id])
  warehouse          Warehouse? @relation(fields: [warehouseId], references: [id])
  bin                Bin        @relation(fields: [binId], references: [id])
  performedBy        User?      @relation(fields: [performedById], references: [id])
}

// ==========================================
// 10. Intelligence, Audit & System Events
// ==========================================

model Forecast {
  id                     String    @id @default(uuid())
  productId              String
  calculatedAt           DateTime  @default(now())
  adu30d                 Float     @default(0.0) // Average Daily Usage
  estimatedDaysRemaining Float     @default(0.0)
  predictedStockoutDate  DateTime?
  recommendedReorderQty  Float     @default(0.0)

  product                Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id               String    @id @default(uuid())
  productId        String?
  insightType      String    // ANOMALY, RUNOUT_WARNING, SLOW_MOVING
  severity         String    // INFO, WARNING, CRITICAL
  title            String
  description      String
  groundedDataJson String?
  isReviewed       Boolean   @default(false)
  createdAt        DateTime  @default(now())

  product          Product?  @relation(fields: [productId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  title      String
  message    String
  severity   String   @default("INFO") // INFO, WARNING, CRITICAL, COMPLETED
  linkUrl    String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  ipAddress    String?
  action       String   // e.g. STOCK_ADJUSTMENT, PRODUCT_DELETE, LOGIN
  resourceType String
  resourceId   String
  diffJson     String?
  timestamp    DateTime @default(now())
  recordHash   String?

  actor        User?    @relation(fields: [actorId], references: [id])
}
