# StockSense Backend Environment Variables

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (SQLite local file for zero-config dev)
DATABASE_URL="file:./dev.db"

# JWT Secret Keys (Rotate in production)
JWT_ACCESS_SECRET="stocksense-dev-jwt-access-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="stocksense-dev-jwt-refresh-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Logging Level (debug, info, warn, error)
LOG_LEVEL="info"
